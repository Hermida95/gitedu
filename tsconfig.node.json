{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "out-tsc/node",
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"]
}
